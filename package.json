{
  "name": "dsh-isolation-gate",
  "version": "1.13.3",
  "description": "Access gate for AI coding harnesses (DSH plugin + Claude Code hook): per-directory deny/read/full, roster groups, audit log, model-facing tools with owner-approved widening.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "access-control",
    "permissions",
    "sandbox",
    "isolation",
    "security",
    "audit-log",
    "policy",
    "tool-gating",
    "ai-agent",
    "dsh-bundle",
    "coding-agent",
    "agent-sandbox",
    "guardrails",
    "claude-code",
    "zcode",
    "opencode",
    "pi-coding-agent",
    "codex",
    "cursor",
    "mcp",
    "harness"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "bin": {
    "gate": "bin/gate.mjs",
    "gate-hook-claude": "bin/gate-hook-claude.mjs",
    "gate-hook-gemini": "bin/gate-hook-gemini.mjs",
    "gate-mcp": "bin/gate-mcp.mjs",
    "gate-hook-generic": "bin/gate-hook-generic.mjs",
    "gate-ui": "bin/gate-ui.mjs"
  },
  "files": [
    "lib",
    "bin",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "node test/run-all.mjs",
    "gate": "node bin/gate.mjs",
    "release:check": "node scripts/release-sync.mjs",
    "verify:publish": "node scripts/verify-publish.mjs",
    "verify:install": "node scripts/verify-install.mjs",
    "prepublishOnly": "node scripts/prepublish-check.mjs",
    "check:release": "node scripts/prepublish-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huanlin-labs/dsh-isolation-gate.git"
  },
  "homepage": "https://github.com/huanlin-labs/dsh-isolation-gate#readme",
  "bugs": {
    "url": "https://github.com/huanlin-labs/dsh-isolation-gate/issues"
  }
}
