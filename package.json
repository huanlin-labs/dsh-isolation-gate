{
  "name": "dsh-isolation-gate",
  "version": "0.3.0",
  "description": "门禁 · 目录访问管制（隔离区授权台）：一屏管理「哪些目录受管、各自什么级别」，三级=禁/只读/可读写删；判定同时挂在受管辖通道（bin/gate.mjs）与宿主工具执行门（ctx.tools.guard）上，默认禁、名单缺失一律拒绝（fail-closed）、审计可查、agent 可自查；支持分组批量切、目录选择器与状态文件自动迁移。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "isolation-gate",
    "permissions",
    "isolation",
    "authorization",
    "sandbox",
    "agent-safety",
    "access-control",
    "windows",
    "deepseek-harness",
    "cordis",
    "ai-agent",
    "security"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "bin": {
    "gate": "bin/gate.mjs"
  },
  "files": [
    "lib",
    "bin",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "node test/run-all.mjs",
    "gate": "node bin/gate.mjs",
    "release:check": "node scripts/release-sync.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaorui-wu/dsh-isolation-gate.git"
  },
  "homepage": "https://github.com/zhaorui-wu/dsh-isolation-gate#readme",
  "bugs": {
    "url": "https://github.com/zhaorui-wu/dsh-isolation-gate/issues"
  }
}
